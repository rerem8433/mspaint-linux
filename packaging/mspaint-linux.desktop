[Desktop Entry]
Type=Application
Name=Paint
GenericName=Logiciel de dessin
Comment=Dessiner et retoucher des images (clone de MS Paint)
Exec=mspaint %f
Icon=mspaint-linux
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/png;image/jpeg;image/bmp;image/gif;image/tiff;
Keywords=paint;dessin;image;pinceau;mspaint;
StartupWMClass=mspaint-MainLauncher
